# === 明幾AI命理 后端生产环境配置 ===

# 服务端口
PORT=8787

# CORS：生产环境只允许 App 域名和空来源（App 不发 Origin）
CORS_ORIGINS=*

# AI 提供商（gemini / deepseek）
AI_PROVIDER=deepseek

# Gemini（如果用 gemini）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek（默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 兜底 AI（可选，DeepSeek/Gemini 都挂时启用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 抓取开关（生产建议关闭，用预置数据）
SCRAPE_ENABLED=false
SCRAPE_INTERVAL_MIN=720

# Google Play 服务账号（正式上线时填）
PLAY_PACKAGE_NAME=com.qjbx.app
PLAY_SERVICE_ACCOUNT=credentials/google-play-service-account.json
