# 复制为 .env 并填写
# AI 提供方：deepseek 或 gemini 或 openai（主提供商）
AI_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-chat

# Gemini（次选兜底，带 Google 联网搜索）
GEMINI_API_KEY=你的Gemini_API_Key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / ChatGPT（第二层兜底：主 AI 失败时自动切换）
OPENAI_API_KEY=你的OpenAI_API_Key
OPENAI_MODEL=gpt-4o-mini

# 服务端口
PORT=8787

# 抓取开关与频率(分钟)
SCRAPE_ENABLED=true
SCRAPE_INTERVAL_MIN=720

# 可选：抓取香港网站的代理(访问受限环境才需要)，如 http://user:pass@host:port
PROXY_URL=